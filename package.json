{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, offline API development tool",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/desktop",
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/desktop",
    "build:core": "npm run build --workspace=packages/core",
    "build:desktop": "npm run build --workspace=packages/desktop",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "typecheck": "tsc --build",
    "test": "npm run test --workspace=packages/core",
    "clean": "rm -rf packages/*/dist packages/*/node_modules/.vite"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "express-rate-limit": "^8.5.1",
    "fast-uri": "^3.1.2",
    "hono": "^4.13.0"
  }
}
